# Porta publicada no host (o container escuta na 3000)
PORTA=8080

# Botao "Me pague um cafe": link da sua pagina de doacao (vazio = sem botao). Ex.:
# CAFE_URL=https://buymeacoffee.com/seu-usuario     (cartao, Apple/Google Pay)
# CAFE_URL=https://livepix.gg/seu-usuario           (Pix)
CAFE_URL=
# Chave Pix mostrada junto (com botao copiar). Telefone, e-mail, CPF ou chave aleatoria
PIX_CHAVE=
